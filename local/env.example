# 로컬 실행 설정 예시. 저장소 맨 위에 .env 로 복사해서 쓴다 (.env 는 저장소에 올리지 않는다).
#   cp local/env.example .env

# Groq 무료 등급 API 키 (https://console.groq.com/keys 에서 직접 만든다)
GROQ_API_KEY=

# 모델 (Groq). 서류 글자 읽기·HS 검색어·채팅은 MODEL_ID, 사진 서류는 VISION_MODEL_ID
MODEL_ID=openai/gpt-oss-120b
VISION_MODEL_ID=qwen/qwen3.8-27b

# 다른 OpenAI 호환 서버를 쓰려면 (예: 내 PC의 Ollama)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# MODEL_ID=qwen3:8b

# 현황 채팅을 Agent(도구 고르기)로 답할지. 끄면 질문을 조건으로 바꾸는 가벼운 방식
QUERY_AGENT=1

# 사진·스캔 PDF OCR (선택). Tesseract 를 깔았고 PATH 에 없으면 위치를 적는다
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_LANG=kor+eng

# 같은 파일을 다시 올렸을 때 모델 판독을 다시 하려면
# NO_CACHE=1
